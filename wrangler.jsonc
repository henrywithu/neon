{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "none",
    "run_worker_first": ["/lobby", "/room/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "NeonRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NeonRoom"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [
    { "pattern": "neon.henrywithu.com", "custom_domain": true }
  ]
}
